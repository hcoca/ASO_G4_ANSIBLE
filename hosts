[servidor]
opensuse_server_1 ansible_host=192.168.1.67
opensuse_server_2 ansible_host=192.168.1.68

[servidor:vars]
ansible_user=root

# ==============================================================================
# Security Improvement: No Plaintext Passwords
# ==============================================================================
#    Ansible Vault (Encrypted Password):
#    Store the password in group_vars/servidor/vault.yml and encrypt it:
#    ansible-vault encrypt group_vars/servidor/vault.yml
#    ansible_password="{{ vault_ansible_password }}"

# ==============================================================================
ansible_password="{{ vault_ansible_password | default(omit) }}"
